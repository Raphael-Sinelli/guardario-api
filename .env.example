# Copie para .env (que não vai para o Git) e preencha. Nenhuma variável é obrigatória no perfil dev.

# Chave do JWT, com pelo menos 32 caracteres. Sem ela, a API gera uma chave aleatória a cada subida.
JWT_SECRET=

# Origens liberadas no CORS para o app (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://10.0.2.2:*

# Perfil: dev (H2 em memória) ou prod (PostgreSQL)
SPRING_PROFILES_ACTIVE=dev

# Só no perfil prod
DB_URL=jdbc:postgresql://localhost:5432/guardario
DB_USERNAME=guardario
DB_PASSWORD=
SEED_ENABLED=false

# Primeiro ADMIN do perfil prod (a senha precisa ter de 8 a 72 caracteres). Criado só se o email ainda não existir.
ADMIN_EMAIL=
ADMIN_PASSWORD=
